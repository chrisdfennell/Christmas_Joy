<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
        Christmas Joy - an evergreen wreath around a snow globe. Inside: a little
        cottage, pine trees and drifting snow; the time in gold script; a
        Christmas countdown on top; and seven spots of data the wearer picks.

        AMOLED round watches only (CIQ 4.0+): the soft colours need a full-colour
        panel, and the 64-colour MIP palettes would band them badly. The
        crossover watch is left out because its physical hands cover the face.

        Everything is laid out on a 454x454 base and scaled to the panel;
        tools/gen_fonts.py bakes a font set per panel size and monkey.jungle
        maps every product to its set.
    -->
    <iq:application id="36fcb7d6-645b-461d-b136-b2e4062ffdb9" type="watchface" name="@Strings.AppName" entry="ChristmasJoyApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="4.0.0">
        <iq:products>
            <!-- Forerunner -->
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>

            <!-- fenix / epix -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>

            <!-- Venu / Vivoactive -->
            <iq:product id="venu2"/>
            <iq:product id="venu2plus"/>
            <iq:product id="venu2s"/>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>

            <!-- Instinct (AMOLED) -->
            <iq:product id="instinct3amoled45mm"/>
            <iq:product id="instinct3amoled50mm"/>

            <!-- Specialty: golf (Approach), dive (Descent), aviation (D2), MARQ -->
            <iq:product id="approachs50"/>
            <iq:product id="approachs7042mm"/>
            <iq:product id="approachs7047mm"/>
            <iq:product id="d2airx10"/>
            <iq:product id="d2mach1"/>
            <iq:product id="d2mach2"/>
            <iq:product id="descentg2"/>
            <iq:product id="descentmk343mm"/>
            <iq:product id="descentmk351mm"/>
            <iq:product id="marq2"/>
            <iq:product id="marq2aviator"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
        </iq:barrels>
    </iq:application>
</iq:manifest>
